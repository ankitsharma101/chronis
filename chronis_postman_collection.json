{
  "info": {
    "name": "Chronis Privacy-Aware Memory Timeline API",
    "description": "Postman Collection for Chronis SDE Intern Assignment - Round 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "user_demo",
      "type": "string"
    },
    {
      "key": "sampleEventId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Events",
      "item": [
        {
          "name": "List Events (Chronological)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["events"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "List Events (Filtered by Type)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events?type=conversation",
              "host": ["{{baseUrl}}"],
              "path": ["events"],
              "query": [
                { "key": "type", "value": "conversation" }
              ]
            }
          }
        },
        {
          "name": "Create Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) { pm.collectionVariables.set('sampleEventId', jsonData.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"conversation\",\n  \"title\": \"Architecture Review with Team\",\n  \"content\": \"Discussed zero-leakage backend privacy controls.\",\n  \"timestamp\": \"2026-11-15T12:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            }
          }
        },
        {
          "name": "Get Single Event by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{sampleEventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{sampleEventId}}"]
            }
          }
        },
        {
          "name": "Delete Event by ID",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{sampleEventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{sampleEventId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Privacy Controls",
      "item": [
        {
          "name": "Get Current Permissions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["permissions"]
            }
          }
        },
        {
          "name": "Toggle Permission (Turn Location OFF)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["permissions"]
            }
          }
        },
        {
          "name": "Toggle Permission (Turn Location ON)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["permissions"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Audit Log",
      "item": [
        {
          "name": "Get Audit Log (Read-Only)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/audit-log?page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["audit-log"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Test Immutability (POST Rejected with 405)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"TAMPER_LOG\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/audit-log",
              "host": ["{{baseUrl}}"],
              "path": ["audit-log"]
            }
          }
        }
      ]
    }
  ]
}
